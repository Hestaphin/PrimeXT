#include <windows.h>
#include "pxwe_resource.h"

1 RT_MANIFEST "pxwe.manifest"
1 VERSIONINFO
 FILEVERSION 1,0,9,7
 PRODUCTVERSION 1,0,9,7
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "PrimeXT Weapon Editor\0"
   VALUE "FileVersion", "J.10.6.9.7\0"
   VALUE "InternalName", "pxwe\0"
   VALUE "OriginalFilename", "pxwe.exe\0"
   VALUE "ProductName", "PrimeXT Weapon Editor\0"
   VALUE "ProductVersion", "J.10.6.9.7\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

IDD_INPUT DIALOGEX 0, 0, 320, 96
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "pxwe"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "", IDC_PROMPT, 10, 10, 300, 25
 EDITTEXT IDC_INPUT, 10, 39, 300, 15, ES_AUTOHSCROLL
 DEFPUSHBUTTON "OK", IDOK, 200, 68, 52, 18
 PUSHBUTTON "Cancel", IDCANCEL, 258, 68, 52, 18
END

IDD_REPORT DIALOGEX 0, 0, 480, 270
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "pxwe validation"
FONT 9, "Segoe UI"
BEGIN
 EDITTEXT IDC_REPORT, 10, 10, 460, 224, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
 DEFPUSHBUTTON "Close", IDOK, 408, 242, 62, 18
END

IDD_VARIANT DIALOGEX 0, 0, 380, 171
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Conditional asset"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Entry ID", -1, 10, 12, 65, 12
 EDITTEXT IDC_VARIANT_ID, 80, 10, 290, 15, ES_AUTOHSCROLL
 LTEXT "Asset role", -1, 10, 36, 65, 12
 COMBOBOX IDC_VARIANT_ROLE, 80, 34, 290, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Resource", -1, 10, 60, 65, 12
 EDITTEXT IDC_VARIANT_PATH, 80, 58, 229, 15, ES_AUTOHSCROLL
 PUSHBUTTON "Browse...", IDC_VARIANT_BROWSE, 315, 57, 55, 17
 LTEXT "Condition", -1, 10, 84, 65, 12
 COMBOBOX IDC_VARIANT_WHEN, 80, 82, 290, 110, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
 LTEXT "default, random, mode:<auto/semi/burst/single>, or ammo:<allowed ID>.\nOne explicit default per role. Sound paths are relative to sound/.", -1, 10, 108, 360, 27
 DEFPUSHBUTTON "Apply", IDOK, 254, 143, 55, 18
 PUSHBUTTON "Cancel", IDCANCEL, 315, 143, 55, 18
END

IDD_OVERRIDES DIALOGEX 0, 0, 430, 247
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Cartridge asset overrides"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "View model", -1, 10, 12, 75, 12
 EDITTEXT 1100, 90, 10, 270, 15, ES_AUTOHSCROLL
 PUSHBUTTON "Browse...", 1120, 365, 9, 55, 17
 LTEXT "Player model", -1, 10, 36, 75, 12
 EDITTEXT 1101, 90, 34, 270, 15, ES_AUTOHSCROLL
 PUSHBUTTON "Browse...", 1121, 365, 33, 55, 17
 LTEXT "World model", -1, 10, 60, 75, 12
 EDITTEXT 1102, 90, 58, 270, 15, ES_AUTOHSCROLL
 PUSHBUTTON "Browse...", 1122, 365, 57, 55, 17
 LTEXT "Firing sound", -1, 10, 84, 75, 12
 EDITTEXT 1103, 90, 82, 270, 15, ES_AUTOHSCROLL
 PUSHBUTTON "Browse...", 1123, 365, 81, 55, 17
 LTEXT "Reload sound", -1, 10, 108, 75, 12
 EDITTEXT 1104, 90, 106, 270, 15, ES_AUTOHSCROLL
 PUSHBUTTON "Browse...", 1124, 365, 105, 55, 17
 LTEXT "Weapon sprite", -1, 10, 132, 75, 12
 EDITTEXT 1105, 90, 130, 270, 15, ES_AUTOHSCROLL
 PUSHBUTTON "Browse...", 1125, 365, 129, 55, 17
 LTEXT "HUD sprite", -1, 10, 156, 75, 12
 EDITTEXT 1106, 90, 154, 270, 15, ES_AUTOHSCROLL
 PUSHBUTTON "Browse...", 1126, 365, 153, 55, 17
 LTEXT "Kill sprite", -1, 10, 180, 75, 12
 EDITTEXT 1107, 90, 178, 270, 15, ES_AUTOHSCROLL
 PUSHBUTTON "Browse...", 1127, 365, 177, 55, 17
 LTEXT "Blank uses the conditional/default resource. Sounds are relative to sound/.\nFiring uses loaded ammo; reloading uses selected ammo.", -1, 10, 201, 290, 29
 DEFPUSHBUTTON "Apply", IDOK, 304, 220, 55, 18
 PUSHBUTTON "Cancel", IDCANCEL, 365, 220, 55, 18
END

IDR_ACCEL ACCELERATORS
BEGIN
 "O", CMD_OPEN, VIRTKEY, CONTROL
 "S", CMD_SAVE, VIRTKEY, CONTROL
 "N", CMD_NEW_WEAPON, VIRTKEY, CONTROL
 "N", CMD_NEW_CARTRIDGE, VIRTKEY, CONTROL, SHIFT
 "D", CMD_DUPLICATE, VIRTKEY, CONTROL
 VK_DELETE, CMD_DELETE, VIRTKEY, CONTROL
 "Z", CMD_UNDO, VIRTKEY, CONTROL
 "Y", CMD_REDO, VIRTKEY, CONTROL
 VK_F5, CMD_VALIDATE, VIRTKEY
END
