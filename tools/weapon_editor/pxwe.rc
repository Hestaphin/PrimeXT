#include <windows.h>
#include "pxwe_resource.h"

1 RT_MANIFEST "pxwe.manifest"
1 VERSIONINFO
 FILEVERSION 1,0,0,9
 PRODUCTVERSION 1,0,0,9
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "PrimeXT Weapon Editor\0"
   VALUE "FileVersion", "J.10.6.9\0"
   VALUE "InternalName", "pxwe\0"
   VALUE "OriginalFilename", "pxwe.exe\0"
   VALUE "ProductName", "PrimeXT Weapon Editor\0"
   VALUE "ProductVersion", "J.10.6.9\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

IDD_INPUT DIALOGEX 0, 0, 320, 96
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "pxwe"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "", IDC_PROMPT, 10, 10, 300, 25
 EDITTEXT IDC_INPUT, 10, 39, 300, 15, ES_AUTOHSCROLL
 DEFPUSHBUTTON "OK", IDOK, 200, 68, 52, 18
 PUSHBUTTON "Cancel", IDCANCEL, 258, 68, 52, 18
END

IDD_REPORT DIALOGEX 0, 0, 480, 270
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "pxwe validation"
FONT 9, "Segoe UI"
BEGIN
 EDITTEXT IDC_REPORT, 10, 10, 460, 224, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
 DEFPUSHBUTTON "Close", IDOK, 408, 242, 62, 18
END

IDR_ACCEL ACCELERATORS
BEGIN
 "O", CMD_OPEN, VIRTKEY, CONTROL
 "S", CMD_SAVE, VIRTKEY, CONTROL
 "N", CMD_NEW_WEAPON, VIRTKEY, CONTROL
 "N", CMD_NEW_CARTRIDGE, VIRTKEY, CONTROL, SHIFT
 "D", CMD_DUPLICATE, VIRTKEY, CONTROL
 VK_DELETE, CMD_DELETE, VIRTKEY, CONTROL
 "Z", CMD_UNDO, VIRTKEY, CONTROL
 "Y", CMD_REDO, VIRTKEY, CONTROL
 VK_F5, CMD_VALIDATE, VIRTKEY
END
