# J.10.6.9.3 format-3 metadata sample. Conditional asset activation is step 5.
version = 3
id = test_pistol
display_name = Test Pistol
runtime_id = 32
ammo_name = 9mm
default_cartridge = test_fmj
clip_size = 17
default_ammo = 17
max_carry = 250
slot = 1
position = 4
weight = 10
view_model = models/v_9mmhandgun.mdl
player_model = models/p_9mmhandgun.mdl
world_model = models/w_9mmhandgun.mdl
fire_sound = weapons/pl_gun3.wav
fire_animation = 3
draw_animation = 7
reload_animation = 5
fire_interval = 0.3
spread = 0.01
reload_seconds = 1.5
range = 8192
bullet_type = 1
accept = test_fmj:360
accept = test_jhp:335
# Reusable shared weapon actions (no new game DLL class required).
primary_behavior = ballistic
primary_mode = semi
primary_projectiles = 1
primary_recoil_pitch = -2.0
secondary_behavior = ammo_cycle
secondary_mode = semi
secondary_interval = 0.25
secondary_spread = 0.00
secondary_projectiles = 1
secondary_ammo_cost = 0
muzzle_flash = true
fire_underwater = false
auto_reload = true
idle_animation = 0
idle_seconds = 3
animation_extension = onehanded

category = pistols/9x19
asset.base_view.role = view_model
asset.base_view.path = models/v_9mmhandgun.mdl
asset.base_view.when = default
asset.semi_view.role = view_model
asset.semi_view.path = models/v_9mmhandgun.mdl
asset.semi_view.when = mode:semi
asset.jhp_view.role = view_model
asset.jhp_view.path = models/v_9mmhandgun.mdl
asset.jhp_view.when = ammo:test_jhp
asset.fire1.role = fire_sound
asset.fire1.path = weapons/pl_gun3.wav
asset.fire1.when = random
asset.fire2.role = fire_sound
asset.fire2.path = weapons/pl_gun3.wav
asset.fire2.when = random
asset.icon.role = hud_sprite
asset.icon.path = sprites/weapon_9mmhandgun.txt
asset.icon.when = default
ammo.test_jhp.fire_sound = weapons/pl_gun3.wav
ammo.test_jhp.reload_sound = weapons/357_reload1.wav
ammo.test_jhp.hud_sprite = sprites/weapon_9mmhandgun.txt
