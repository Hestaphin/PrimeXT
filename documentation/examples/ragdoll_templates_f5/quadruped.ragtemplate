        region "torso"
        frame_mode segment
        frame_anchor 0 0 0
        frame_angles 0 0 0
        flexion_sign 1
        twist_motion limited
        swing1_motion limited
        swing2_motion limited
        swing1 35
        swing2 35
        twist_low -25
        twist_high 25
