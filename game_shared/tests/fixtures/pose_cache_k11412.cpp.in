extern "C" const char *__asan_default_options() { return "detect_leaks=0:halt_on_error=1"; }
#define Q_stricmp strcasecmp
struct CBaseEntity;
struct entvars_t
{
    Vector origin{0,0,0}, angles{0,0,0};
    int modelindex=1,sequence=0,gaitsequence=0,body=0,skin=0,movetype=0,iuser1=0,solid=1;
    float frame=0,animtime=0,framerate=1,scale=1;
    byte controller[4]{},blending[2]{};
};
struct edict_s { bool free=false; int serialnumber=1; CBaseEntity *owner=nullptr; };
static std::array<model_t *, 256> models{};
#define MODEL_HANDLE(index) models[index]
struct CBaseEntity
{
    entvars_t vars; entvars_t *pev=&vars; edict_t ed; int index=1;
    Vector absOrigin{0,0,0},absAngles{0,0,0},scale{1,1,1};
    CBaseEntity() { ed.owner=this; }
    edict_t *edict() { return &ed; }
    int entindex() { return index; }
    Vector GetAbsOrigin() { return absOrigin; }
    Vector GetAbsAngles() { return absAngles; }
    Vector GetScale() { return scale; }
    const char *GetModel() { return models[pev->modelindex]->name; }
};
static int boneQueries=0;
static bool badBone=false;
static bool unwrittenBone=false;
static void GET_BONE_POSITION(edict_t *edict,int bone,Vector &origin,Vector &angles)
{
    ++boneQueries;
    if(unwrittenBone) return;
    const entvars_t &v=*edict->owner->pev;
    const float phase=v.frame+v.sequence+float(v.controller[0])*.01f+float(v.blending[0])*.001f;
    matrix4x4 root(v.origin,v.angles,1.0f);
    origin=root.VectorTransform(Vector(20.0f*bone+phase,0,0));
    angles=v.angles; angles.y+=phase;
    if(badBone) origin.x=NAN;
}
namespace physx
{
using PxU32=std::uint32_t;
struct PxMat44 {float m[16];explicit PxMat44(const float *v){std::copy(v,v+16,m);}};
struct PxIdentityType {}; constexpr PxIdentityType PxIdentity{};
struct PxTransform
{
    matrix4x4 matrix;
    explicit PxTransform(PxIdentityType):matrix(Vector(0,0,0),Vector(0,0,0),1.0f){}
    explicit PxTransform(PxMat44 m):matrix(m.m){}
    explicit PxTransform(matrix4x4 m):matrix(m){}
    PxTransform operator*(const PxTransform &other) const {return PxTransform(matrix.ConcatTransforms(other.matrix));}
};
struct PxShapeFlag {enum Enum {eSIMULATION_SHAPE=1,eSCENE_QUERY_SHAPE=2};};
struct PxShape {unsigned flags=3;unsigned getFlags() const {return flags;}};
struct PxRigidDynamic
{
    PxTransform pose{PxIdentity};
    PxTransform getGlobalPose() const {return pose;}
};
struct PxRevoluteJoint {};
}
using namespace physx;
static matrix4x4 MatrixFromPxTransform(const PxTransform &pose) {return pose.matrix;}
using PhysicsAssetDef=physicsasset::AssetDef;
using PhysicsAssetBodyDef=physicsasset::BodyDef;
struct PhysicsAssetInstance
{
    CBaseEntity *m_owner;
    float m_rigidScale;
    PxTransform BodyLocalTransform(const PhysicsAssetBodyDef &) const;
    PxTransform BoneWorldTransform(int,const PhysicsAssetBodyDef &) const;
};
enum class PhysicsPartMode { Animated, Free, Driven };
namespace clipfile {enum class GeometryType {Original,CookedTriangleMesh};}
struct mvert_t {Vector point;float st[2]{};};
struct RecordedTriangle {std::array<Vector,3> point;int skin=0;};
struct CMeshDesc
{
    inline static int builds=0,finishes=0;
    inline static bool failInit=false,failFinish=false;
    inline static std::size_t forcedMemory=0;
    std::vector<RecordedTriangle> triangles;
    bool finished=false;
    int body=0,skin=0;
    void SetDebugName(const char *) {}
    void SetModel(const model_t *,int b,int s) {body=b;skin=s;}
    void SetGeometryType(clipfile::GeometryType) {}
    bool InitMeshBuild(int) {++builds;return !failInit;}
    bool AddMeshTrinagle(Vector *points)
    {triangles.push_back({{points[0],points[1],points[2]},0});return true;}
    bool AddMeshTrinagle(mvert_t *points,int material)
    {triangles.push_back({{points[0].point,points[1].point,points[2].point},material});return true;}
    bool FinishMeshBuild() {++finishes;finished=!failFinish;return finished;}
    void FreeMeshBuild() {}
    CMeshDesc *GetMesh() {return finished?this:nullptr;}
    std::size_t GetMeshMemorySize() const {return forcedMemory?forcedMemory:triangles.size()*sizeof(RecordedTriangle);}
    void *GetHeadNode() {return nullptr;}
    int GetBody() {return body;} int GetSkin() {return skin;}
    void StudioConstructMesh() {finished=true;triangles.push_back({{Vector(0,0,0),Vector(1,0,0),Vector(0,1,0)},0});}
};
constexpr int MAX_TRIANGLES_SOFT=100000;
struct TraceMesh
{
    CMeshDesc *mesh=nullptr;int skin=0;
    trace_t *result=nullptr;
    void SetTraceMesh(CMeshDesc *m,void *,int,int,int s) {mesh=m;skin=s;}
    void SetMeshOrientation(const Vector &,const Vector &,const Vector &) {}
    void SetupTrace(const Vector &,const Vector &,const Vector &,const Vector &,trace_t *r) {result=r;}
    bool DoTrace()
    {
        if(!mesh || mesh->triangles.empty()) return false;
        result->fraction=.5f;result->endpos=mesh->triangles[0].point[0];result->plane.normal=Vector(0,0,1);return true;
    }
    std::uint32_t GetLastHitSurface() {return std::uint32_t(500+skin);}
};
static std::uint32_t COM_GetMaterialHash(std::uint32_t value) {return value;}
struct CMeshDescFactory
{
    CMeshDesc reference;
    static CMeshDescFactory &Instance() {static CMeshDescFactory factory;return factory;}
    CMeshDesc &CreateObject(int,int b,int s,clipfile::GeometryType) {reference.body=b;reference.skin=s;return reference;}
};
struct CPhysicPhysX
{
    @STRUCTS@
    bool HasPhysicsAssetCollision(CBaseEntity *) {return true;}
    void RebuildAnimatedCollisionTraceMesh(CBaseEntity *,PhysicsAssetCollisionState &,const PhysicsAssetDef &);
    void BaselineCollision(CBaseEntity *,PhysicsAssetCollisionState &,const PhysicsAssetDef &);
    bool ResolveRenderImpact(CBaseEntity *,const Vector &,const Vector &,Vector &,Vector &,std::uint32_t &);
};

