static std::string openPath,savePath;
static int confirm=0,panelApplies=0;
extern "C" const char *mxGetOpenFileName(mxWindow*,const char*,const char*) { return openPath.empty()?nullptr:openPath.c_str(); }
extern "C" const char *mxGetSaveFileName(mxWindow*,const char*,const char*) { return savePath.empty()?nullptr:savePath.c_str(); }
int mxMessageBox(mxWindow*,const char*,const char*,int) { return confirm; }
