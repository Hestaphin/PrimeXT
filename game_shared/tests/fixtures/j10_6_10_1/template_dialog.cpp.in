struct WidgetRecord {int x,y,w,h; std::string label; bool visible=true; void *handle=nullptr; mxWindow *parent=nullptr;};
class mxWidget_i {public: WidgetRecord record;};
static std::map<const mxWidget*,WidgetRecord*> widgets;
class mxWindow_i {public: std::vector<mxWidget*> children;};
mxWidget::mxWidget(mxWindow *parent,int x,int y,int w,int h,const char *label):d_this(new mxWidget_i) {
    d_this->record={x,y,w,h,label ? label : "",true,this,parent};widgets[this]=&d_this->record;
}
mxWidget::~mxWidget() {widgets.erase(this);delete d_this;}
void mxWidget::setHandle(void *value) {d_this->record.handle=value;}
void *mxWidget::getHandle() const {return d_this->record.handle;}
void mxWidget::setParent(mxWindow *value) {d_this->record.parent=value;}
mxWindow *mxWidget::getParent() const {return d_this->record.parent;}
void mxWidget::setType(int) {}
void mxWidget::setVisible(bool value) {d_this->record.visible=value;}
bool mxWidget::isVisible() const {return d_this->record.visible;}
void mxWidget::setLabel(const char *value) {d_this->record.label=value ? value : "";}
const char *mxWidget::getLabel() const {return d_this->record.label.c_str();}
mxWindow::mxWindow(mxWindow *parent,int x,int y,int w,int h,const char *label,int):
    mxWidget(parent,x,y,w,h,label),d_this(new mxWindow_i) {if(parent) parent->addWidget(this);}
mxWindow::~mxWindow() {for(auto *widget:d_this->children) delete widget;delete d_this;}
void mxWindow::addWidget(mxWidget *widget) {d_this->children.push_back(widget);}
int mxWindow::handleEvent(mxEvent*) {return 0;}
void mxWindow::redraw() {}
mxButton::mxButton(mxWindow *p,int x,int y,int w,int h,const char *s,int):mxWidget(p,x,y,w,h,s) {p->addWidget(this);}
mxButton::~mxButton()=default;
mxLabel::mxLabel(mxWindow *p,int x,int y,int w,int h,const char *s):mxWidget(p,x,y,w,h,s) {p->addWidget(this);}
mxLabel::~mxLabel()=default;
mxLineEdit::mxLineEdit(mxWindow *p,int x,int y,int w,int h,const char *s,int,int):mxWidget(p,x,y,w,h,s) {p->addWidget(this);}
mxLineEdit::~mxLineEdit()=default;
mxChoice::mxChoice(mxWindow *p,int x,int y,int w,int h,int):mxWidget(p,x,y,w,h) {p->addWidget(this);}
mxChoice::~mxChoice()=default;
static std::map<const mxWidget*,std::vector<std::string>> items;
static std::map<const mxWidget*,int> selection;
static std::map<const mxWidget*,bool> enabled,checked;
void mxWidget::setEnabled(bool value) { enabled[this]=value; }
void mxChoice::add(const char *text) { items[this].push_back(text); }
void mxChoice::select(int index) { selection[this]=index; }
int mxChoice::getSelectedIndex() const { return selection[this]; }
void mxChoice::removeAll() { items[this].clear();selection[this]=-1; }
mxListBox::mxListBox(mxWindow *p,int x,int y,int w,int h,int,int):mxWidget(p,x,y,w,h) {p->addWidget(this);}
mxListBox::~mxListBox()=default;
