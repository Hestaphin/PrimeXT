struct POINT {int x=0,y=0;};struct TVHITTESTINFO {POINT pt;unsigned flags=0;};
HTREEITEM hitItem=nullptr;
void TreeView_DeleteAllItems(HWND w){w->nodes.clear();w->treeSelection=nullptr;}
HTREEITEM TreeView_InsertItem(HWND w,TVINSERTSTRUCTW* in){auto n=std::make_unique<Node>();n->parent=in->hParent;n->param=in->item.lParam;n->label=in->item.pszText;const auto p=n.get();w->nodes.push_back(std::move(n));return p;}
unsigned TreeView_GetItemState(HWND,HTREEITEM n,unsigned){return n->expanded?TVIS_EXPANDED:0;}
void TreeView_Expand(HWND w,HTREEITEM n,unsigned){for(const auto& child:w->nodes)if(child->parent==n){n->expanded=true;return;}}
void TreeView_SelectItem(HWND w,HTREEITEM n){w->treeSelection=n;}
void TreeView_EnsureVisible(HWND,HTREEITEM n){for(n=n->parent;n;n=n->parent)n->expanded=true;}
HTREEITEM TreeView_GetSelection(HWND w){return w->treeSelection;}
void TreeView_GetItemRect(HWND,HTREEITEM,RECT* r,int){*r={5,5,100,25};}
void ClientToScreen(HWND,POINT*){}void ScreenToClient(HWND,POINT*){}
HTREEITEM TreeView_HitTest(HWND,TVHITTESTINFO* h){h->flags=hitItem?TVHT_ONITEM:0;return hitItem;}
int TreeView_GetItem(HWND,TVITEMW* i){if(!i->hItem)return 0;i->lParam=i->hItem->param;return 1;}
