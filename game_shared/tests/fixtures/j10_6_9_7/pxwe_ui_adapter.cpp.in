struct FakeMenu {std::vector<int> commands;};std::vector<int> shownCommands;int popupCommand=0,destroyedMenus=0;
HMENU CreatePopupMenu(){return new FakeMenu;}
void AppendMenuW(HMENU m,unsigned,int command,const wchar_t*){if(command)static_cast<FakeMenu*>(m)->commands.push_back(command);}
int TrackPopupMenu(HMENU m,unsigned,int,int,int,HWND,void*){shownCommands=static_cast<FakeMenu*>(m)->commands;return popupCommand;}
void DestroyMenu(HMENU m){delete static_cast<FakeMenu*>(m);++destroyedMenus;}

