struct CPhysicPhysX {
    struct RagdollEntityState {int solid=0,movetype=0;Vector mins,maxs,angles;matrix4x4 rootToEntity;bool hasRootRelation=false;};
    struct PendingRagdollImpulse {edict_t* edict;Vector impulse,position;int hitGroup;float time;};
    std::map<int,std::vector<PendingRagdollImpulse>> m_pendingRagdollImpulses;
