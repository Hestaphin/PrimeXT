    void TransferPendingRagdollImpulses(CBaseEntity*,PhysicsAssetInstance*);
    void SetRagdoll(CBaseEntity*,bool);void QueuePhysicsAssetImpulse(CBaseEntity*,int,const Vector&,const Vector&);
    bool TraceBallisticPhysicsExit(CBaseEntity*,int,const Vector&,const Vector&,float,Vector&,Vector&);
};
CPhysicPhysX physics;CPhysicPhysX* WorldPhysic=&physics;
float autoDeath=1;float CVAR_GET_FLOAT(const char*){return autoDeath;}
void CBaseEntity::EnableRagdoll(bool on){static_cast<CBaseMonster*>(this)->enableRequests++;WorldPhysic->SetRagdoll(this,on);}
struct Cvar {float value=1;};Cvar ragdoll_bullet_impulse_scale,prop_bullet_impulse_scale;
struct TraceResult {edict_t* pHit;Vector vecEndPos;int iHitgroup=0;};
bool UTIL_IsValidEntity(edict_t* e){return e&&!e->free;}

@PRODUCTION@

struct Scene {
    CBaseMonster monster;PhysicsAssetInstance asset;std::array<PxRigidDynamic,3> actors;
    Scene(){physics=CPhysicPhysX{};WorldPhysic=&physics;globals.time=10;autoDeath=1;monster.asset=&asset;
        for(int i=0;i<3;++i){physicsasset::BodyDef def;def.name="body"+std::to_string(i);def.hitGroup=i+1;
            asset.m_def->bodies.push_back(def);actors[i].pose.p=PxVec3(float(i*10),0,0);
            BodyRuntime body;body.actor=&actors[i];body.boneIndex=i;body.currentAnimationPose=actors[i].pose;asset.m_bodies.push_back(body);}
        asset.joints={&actors[0],&actors[1]};}
    void partial(){asset.m_ragdoll=true;asset.m_bodies[0].physicsWeight=0;asset.m_bodies[1].physicsWeight=0.4f;asset.m_bodies[2].physicsWeight=1;
        actors[1].bodyFlags.bits=0;actors[2].bodyFlags.bits=0;actors[1].linear=PxVec3(7,0,0);}
    void bullet(int body){TraceResult tr{monster.edict(),Vector(float(body*10),0,0),body+1};
        ApplyPhysicsBulletImpulse(&tr,body,{0,0,0},{50,0,0},{1,0,0},3);}
    void full()const{assert(asset.IsRagdoll()&&!asset.NeedsAnimationControl());for(const auto& b:asset.m_bodies){assert(b.physicsWeight==1);assert(!b.actor->bodyFlags.isSet(1));}}
};
void deathCases(){
    // Enter partial ownership through the real weight API, then exercise death
    // with anchors and several drive weights without rebuilding actors/joints.
    for(float weight:{0.0f,0.0005f,0.25f,0.998f}) {
        Scene s;s.monster.origin={3,0,0};s.monster.pev->movetype=5;s.monster.pev->solid=2;
        assert(physics.SetRagdollBodyPhysicsWeight(&s.monster,"body0",0,false));
        assert(physics.SetRagdollBodyPhysicsWeight(&s.monster,"body1",weight,false));
        assert(s.asset.NeedsAnimationControl()&&s.monster.pev->movetype==5);
        const auto joints=s.asset.joints;const auto bodies=s.asset.m_bodies;
        const int snaps=s.asset.snaps,creates=physics.creates;
        s.monster.pev->flags|=FL_ONGROUND;s.monster.pev->groundentity=s.monster.edict();
        s.bullet(0);assert(s.actors[0].impulses==0);
        s.monster.Killed(nullptr,GIB_NORMAL);s.full();
        assert(s.monster.pev->solid==SOLID_NOT&&s.monster.pev->movetype==MOVETYPE_NONE);
        assert(!(s.monster.pev->flags&FL_ONGROUND)&&!s.monster.pev->groundentity);
        assert(s.asset.joints==joints&&s.asset.snaps==snaps&&physics.creates==creates);
        for(size_t i=0;i<bodies.size();++i)assert(bodies[i].actor==s.asset.m_bodies[i].actor);
        assert(s.actors[0].impulses==1&&physics.m_pendingRagdollImpulses.empty());
        std::array<int,3> forces,targets;
        for(size_t i=0;i<3;++i){forces[i]=s.actors[i].forces;targets[i]=s.actors[i].targets;}
        for(int step=0;step<3;++step)s.asset.ApplyAnimationControl(0.01f,100,10,1000);
        for(size_t i=0;i<3;++i)assert(s.actors[i].forces==forces[i]&&s.actors[i].targets==targets[i]);
        const auto saved=physics.m_ragdollEntityState.at(1);
        physics.SetRagdoll(&s.monster,true);s.monster.Killed(nullptr,GIB_NORMAL);
        assert(s.actors[0].impulses==1&&physics.m_ragdollEntityState.size()==1);
        assert(physics.m_ragdollEntityState.at(1).rootToEntity.position.x==saved.rootToEntity.position.x);
    }
    {Scene s;s.bullet(-1);s.monster.Killed(nullptr,GIB_NORMAL);s.full();assert(s.monster.enableRequests==1&&physics.m_ragdollEntityState.size()==1);
        assert(s.actors[0].impulses==1&&physics.m_pendingRagdollImpulses.empty());
        s.monster.Killed(nullptr,GIB_NORMAL);physics.SetRagdoll(&s.monster,true);assert(s.monster.enableRequests==1&&s.actors[0].impulses==1);}
    {Scene s;s.partial();const auto joints=s.asset.joints;const auto actors=s.asset.m_bodies;
        s.asset.ApplyAnimationControl(0.01f,100,10,1000);assert(s.actors[1].forces==1);s.bullet(1);assert(s.actors[1].impulses==1);
        s.bullet(0);assert(s.actors[0].impulses==0&&physics.m_pendingRagdollImpulses.size()==1);
        s.monster.Killed(nullptr,GIB_NORMAL);s.full();assert(s.asset.joints==joints&&physics.creates==0&&s.asset.snaps==0);
        for(size_t i=0;i<actors.size();++i)assert(actors[i].actor==s.asset.m_bodies[i].actor);
        assert(s.actors[0].impulses==1&&s.actors[1].impulses==1&&s.actors[1].linear.x==10);
        int forces=s.actors[1].forces,targets=s.actors[0].targets; s.asset.ApplyAnimationControl(0.01f,100,10,1000);
        assert(s.actors[1].forces==forces&&s.actors[0].targets==targets);
        physics.SetRagdoll(&s.monster,true);s.monster.Killed(nullptr,GIB_NORMAL);assert(physics.m_ragdollEntityState.size()==1&&s.actors[0].impulses==1);}
    {Scene s;s.monster.origin={3,0,0};physics.SetRagdoll(&s.monster,true);
        const auto saved=physics.m_ragdollEntityState.at(1);s.bullet(2);s.monster.Killed(nullptr,GIB_NORMAL);s.full();
        assert(s.monster.pev->movetype==MOVETYPE_NONE&&s.monster.pev->solid==SOLID_NOT);
        const auto after=physics.m_ragdollEntityState.at(1);assert(after.movetype==saved.movetype&&after.rootToEntity.position.x==saved.rootToEntity.position.x);
        assert(physics.m_ragdollEntityState.size()==1&&s.actors[2].impulses==1);}
    {Scene s;s.monster.asset=nullptr;s.monster.Killed(nullptr,GIB_NORMAL);assert(s.monster.enableRequests==0);}
    {Scene s;s.partial();autoDeath=0;s.monster.Killed(nullptr,GIB_NORMAL);assert(s.asset.NeedsAnimationControl()&&s.monster.enableRequests==0);}
    {Scene s;s.partial();s.monster.Killed(nullptr,GIB_ALWAYS);assert(s.monster.gibs==1&&s.monster.enableRequests==0&&s.asset.NeedsAnimationControl());}
    {Scene s;s.monster.pev->flags=0;s.monster.Killed(nullptr,GIB_NORMAL);assert(s.monster.enableRequests==0);}
    {Scene s;s.asset.m_actorsCreated=false;physics.creationSucceeds=false;s.bullet(-1);s.monster.Killed(nullptr,GIB_NORMAL);assert(!s.asset.IsRagdoll()&&physics.m_ragdollEntityState.empty());}
    {Scene s;WorldPhysic=nullptr;s.monster.Killed(nullptr,GIB_NORMAL);assert(s.monster.enableRequests==0);}
    {Scene s;s.partial();s.bullet(0);globals.time=10.3f;s.monster.Killed(nullptr,GIB_NORMAL);assert(s.actors[0].impulses==0&&physics.m_pendingRagdollImpulses.empty());}
    {Scene s;s.bullet(-1);edict_t other;physics.m_pendingRagdollImpulses[1][0].edict=&other;s.monster.Killed(nullptr,GIB_NORMAL);assert(s.actors[0].impulses==0);}
    {Scene s;s.bullet(-1);globals.time=9;s.monster.Killed(nullptr,GIB_NORMAL);assert(s.actors[0].impulses==0);}
    {Scene s;for(int i=0;i<20;++i)s.bullet(-1);assert(physics.m_pendingRagdollImpulses[1].size()==16);s.monster.Killed(nullptr,GIB_NORMAL);assert(s.actors[0].impulses==16);}
    std::cout<<"PASS production death/physics: weight-API promotion matrix, ordinary, partial, free, policies, ownership, drives, single impulses, expiry\n";
}
void shapeCases(){
    std::array<int,3> order{{0,1,2}};int permutations=0;
    do{Scene s;s.monster.asset=nullptr;PxActor root;PxShape a,b,c;a.low=.12f;b.low=.06f;c.low=0;
        std::array<PxShape*,3> shapes{{&a,&b,&c}};for(int i:order)root.shapes.push_back(shapes[i]);s.monster.root=&root;
        Vector exit,normal;assert(!physics.TraceBallisticPhysicsExit(&s.monster,-1,{0,0,0},{1,0,0},10,exit,normal));
        assert(a.reverseQueries+b.reverseQueries+c.reverseQueries==0);++permutations;
    }while(std::next_permutation(order.begin(),order.end()));assert(permutations==6);
    {Scene s;s.monster.asset=nullptr;PxActor root,child;PxShape chosen,far;chosen.low=0;far.low=.3f;chosen.failReverse=true;
        root.shapes={&far,&chosen};s.monster.root=&root;PhysicsPartRuntime part{&child};part.shapes={{&chosen},{&chosen}};
        physics.m_physicsAssetCollisionStates[1]={s.monster.edict(),true,false,{part}};
        Vector out,normal;assert(!physics.TraceBallisticPhysicsExit(&s.monster,-1,{0,0,0},{1,0,0},10,out,normal));
        assert(chosen.forwardQueries==1&&chosen.reverseQueries==1&&far.reverseQueries==0);
        chosen.failReverse=false;assert(physics.TraceBallisticPhysicsExit(&s.monster,-1,{0,0,0},{1,0,0},10,out,normal));assert(out.x==2&&normal.x==1);}
    {Scene s;s.monster.asset=nullptr;PxActor root,child;PxShape a,b;b.low=.06f;root.shapes={&a};s.monster.root=&root;
        PhysicsPartRuntime part{&child};part.shapes={{&b}};physics.m_physicsAssetCollisionStates[1]={s.monster.edict(),true,false,{part}};
        Vector out,normal;assert(!physics.TraceBallisticPhysicsExit(&s.monster,-1,{0,0,0},{1,0,0},10,out,normal));
        b.flags=0;assert(physics.TraceBallisticPhysicsExit(&s.monster,-1,{0,0,0},{1,0,0},10,out,normal));
        physics.m_physicsAssetCollisionStates[1].collisionRequested=false;assert(!physics.TraceBallisticPhysicsExit(&s.monster,-1,{0,0,0},{1,0,0},10,out,normal));}
    {Scene s;s.monster.asset=nullptr;PxActor root;PxShape a;root.shapes.assign(129,&a);s.monster.root=&root;Vector out,normal;
        assert(!physics.TraceBallisticPhysicsExit(&s.monster,-1,{0,0,0},{1,0,0},10,out,normal));}
    std::cout<<"PASS production shape query: six orders, root/child overlap, disabled shapes, deduplication, failed selected exit\n";
}
int main(){deathCases();shapeCases();}
