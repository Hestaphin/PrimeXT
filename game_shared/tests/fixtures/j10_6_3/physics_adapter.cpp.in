struct PxVec3 {
    float x=0,y=0,z=0;
    PxVec3(float a=0):x(a),y(a),z(a){}
    PxVec3(float a,float b,float c):x(a),y(b),z(c){}
    PxVec3 operator+(PxVec3 b)const{return {x+b.x,y+b.y,z+b.z};}
    PxVec3 operator-(PxVec3 b)const{return {x-b.x,y-b.y,z-b.z};}
    PxVec3 operator-()const{return {-x,-y,-z};}
    PxVec3 operator*(float s)const{return {x*s,y*s,z*s};}
    PxVec3& operator*=(float s){*this=*this*s;return *this;}
    float dot(PxVec3 b)const{return x*b.x+y*b.y+z*b.z;}
    float magnitudeSquared()const{return dot(*this);}
    float magnitude()const{return std::sqrt(magnitudeSquared());}
    bool isFinite()const{return std::isfinite(x)&&std::isfinite(y)&&std::isfinite(z);}
};
struct Vector:PxVec3 {
    Vector()=default;Vector(float a,float b,float c):PxVec3(a,b,c){}
    Vector(PxVec3 p):PxVec3(p){}
    Vector Normalize()const {float l=magnitude();return l>0?Vector(*this*(1/l)):Vector();}
    bool operator==(Vector b)const{return x==b.x&&y==b.y&&z==b.z;}
};
using vec3_t=Vector;
const Vector g_vecZero{};
struct PxQuat {
    float x=0,y=0,z=0,w=1;
    PxQuat()=default;PxQuat(float a,float b,float c,float d):x(a),y(b),z(c),w(d){}
    PxQuat getConjugate()const{return {-x,-y,-z,w};}
    void normalize(){float l=std::sqrt(x*x+y*y+z*z+w*w);x/=l;y/=l;z/=l;w/=l;}
    PxQuat operator*(PxQuat b)const{return {w*b.x+x*b.w+y*b.z-z*b.y,
        w*b.y-x*b.z+y*b.w+z*b.x,w*b.z+x*b.y-y*b.x+z*b.w,w*b.w-x*b.x-y*b.y-z*b.z};}
};
struct PxTransform {
    PxVec3 p;PxQuat q;
    bool isValid()const{return p.isFinite()&&std::isfinite(q.w);}
    PxTransform operator*(PxTransform b)const{return {p+b.p,q*b.q};}
};
// Translation-only root-frame adapter; rotation/scale math is covered by the
// separate real project matrix tests. Here the saved relation must stay intact.
struct matrix4x4 {
    PxVec3 position;
    matrix4x4 Invert()const{return {-position};}
    matrix4x4 ConcatTransforms(matrix4x4 b)const{return {position+b.position};}
};
matrix4x4 MatrixFromPxTransform(PxTransform p){return {p.p};}
using PxU32=unsigned;
