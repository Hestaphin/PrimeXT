    std::vector<std::unique_ptr<PhysicsAssetInstance>> m_physicsAssets;
    void* m_pScene=this;int creates=0,ownershipChanges=0,presentations=0;
    bool creationSucceeds=true;
    PhysicsAssetInstance* EnsurePhysicsAssetInstance(CBaseEntity* e){return e->asset;}
    PhysicsAssetInstance* FindPhysicsAsset(CBaseEntity* e){return e->asset;}
