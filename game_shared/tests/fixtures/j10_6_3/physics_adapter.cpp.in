struct Flags {int bits=0;bool isSet(int b)const{return bits&b;}};
struct PxShape;
struct PxGeometryHolder {PxShape* shape;PxShape& any()const{return *shape;}};
struct PxShape {
    int flags=3;float low=0,high=2;bool failReverse=false;int forwardQueries=0,reverseQueries=0;
    PxTransform local;
    int getFlags()const{return flags;}
    PxGeometryHolder getGeometry(){return {this};}
    PxTransform getLocalPose()const{return local;}
};
struct PxRigidActor {
    PxTransform pose;std::vector<PxShape*> shapes;
    PxTransform getGlobalPose()const{return pose;}
    PxU32 getNbShapes()const{return shapes.size();}
    PxU32 getShapes(PxShape** out,PxU32 n){n=std::min(n,getNbShapes());std::copy_n(shapes.begin(),n,out);return n;}
};
struct PxActor:PxRigidActor {template<class T>T* is(){return static_cast<T*>(this);}};
struct PxRigidDynamic:PxActor {
    Flags bodyFlags{1};PxVec3 linear,angular;
    int impulses=0,forces=0,torques=0,targets=0,wakes=0;
    Flags getRigidBodyFlags()const{return bodyFlags;}
    void setRigidBodyFlag(int b,bool on){if(on)bodyFlags.bits|=b;else bodyFlags.bits&=~b;}
    void setLinearVelocity(PxVec3 v){linear=v;} void setAngularVelocity(PxVec3 v){angular=v;}
    PxVec3 getLinearVelocity()const{return linear;} PxVec3 getAngularVelocity()const{return angular;}
    void setGlobalPose(PxTransform v,bool){pose=v;} void setKinematicTarget(PxTransform){++targets;}
    void wakeUp(){++wakes;}void addForce(PxVec3,int){++forces;}void addTorque(PxVec3,int){++torques;}
};
namespace PxRigidBodyExt {void addForceAtPos(PxRigidDynamic& actor,PxVec3 impulse,PxVec3,int){++actor.impulses;actor.linear=actor.linear+impulse;}}
struct PxRaycastHit {PxVec3 position,normal;};
namespace PxGeometryQuery {
    // Analytic box slab along the test ray. No scene or solver is modeled.
    unsigned raycast(PxVec3 origin,PxVec3 dir,PxShape& shape,PxTransform pose,
                     float maximum,PxHitFlags,int,PxRaycastHit* out) {
        const bool reverse=dir.x<0;
        if(reverse){++shape.reverseQueries;if(shape.failReverse)return 0;}
        else ++shape.forwardQueries;
        if(std::fabs(dir.x)<0.99f)return 0;
        const float face=(reverse?shape.high:shape.low)+pose.p.x;
        const float distance=(face-origin.x)/dir.x;
        if(!std::isfinite(distance)||distance<0||distance>maximum)return 0;
        out->position=origin+dir*distance;out->normal={reverse?1.0f:-1.0f,0,0};return 1;
    }
}
bool FiniteVec3(PxVec3 p){return p.isFinite();}
