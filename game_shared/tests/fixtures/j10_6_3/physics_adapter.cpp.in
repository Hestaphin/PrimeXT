struct BodyRuntime {
    PxRigidDynamic* actor=nullptr;float physicsWeight=1;int boneIndex=0;
    bool hasCurrentAnimationPose=true,hasAnimationVelocity=true,hasSimulationPose=false;
    PxTransform currentAnimationPose;PxVec3 animationLinearVelocity{2,0,0},animationAngularVelocity{0,0,1};
};
struct PhysicsAssetInstance {
    CBaseEntity* owner=nullptr;CBaseEntity* Owner()const{return owner;}
    std::shared_ptr<physicsasset::AssetDef> m_def=std::make_shared<physicsasset::AssetDef>();
    std::vector<BodyRuntime> m_bodies;std::vector<void*> joints;
    bool m_ragdoll=false,m_actorsCreated=true,m_frozen=false,m_hasSimulationPose=false,m_hasSimulationBounds=false;
    float m_sleepStartTime=0,m_currentSampleTime=10;int snaps=0,samples=0,captures=0,thaws=0;
    bool MatchesOwnerModel()const{return true;}bool HasActors()const{return m_actorsCreated;}
    bool IsRagdoll()const{return m_ragdoll;}const auto& Bodies()const{return m_bodies;}
    const auto& Definition()const{return *m_def;}int RootBodyIndex()const{return 0;}
    bool GetRootBonePose(PxTransform& out)const{out=m_bodies[0].actor->pose;return true;}
    int FindBody(const char* name)const{for(size_t i=0;i<m_def->bodies.size();++i)if(m_def->bodies[i].name==name)return i;return -1;}
    PxVec3 FallbackLinearVelocity()const{return PxVec3(0);}PxVec3 FallbackAngularVelocity()const{return PxVec3(0);}
    PxTransform BoneWorldTransform(int i,const physicsasset::BodyDef&)const{return m_bodies[i].currentAnimationPose;}
    void Thaw(){++thaws;m_frozen=false;}void UpdateAnimationPose(float){++samples;}
    void SnapToAnimationPose(){++snaps;}void SetSimulationEnabled(bool){}
    void CaptureSimulationPose(){++captures;}void InvalidateAnimationHistory(bool){}void FollowAnimation(){}
    bool RaycastBodyExit(int,PxVec3,PxVec3,float,PxVec3&,PxVec3&){return false;}
    bool NeedsAnimationControl()const;void SetBodyKinematicState(size_t,bool,bool);
    bool IsBodyDescendantOf(size_t,int)const;bool SetBodyPhysicsWeight(const char*,float,bool);
    void ApplyAnimationControl(float,float,float,float);bool AddImpulseToBody(int,const PxVec3&,const PxVec3&);
    bool SetRagdoll(bool);
};
