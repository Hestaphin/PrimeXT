#include <stdio.h>
#include <string.h>
#include <assert.h>
#include <stdbool.h>
#define XASH_TYPES_H
typedef unsigned char byte;
typedef float vec3_t[3];
typedef int qboolean;
#include "const.h"
// Only service-facing fields used by selection are adapted here. This is not
// an engine-header/ABI build; generated build.h and the GL SDK are unavailable.
#define MAX_OSPATH 260
#define RF_DRAW_WORLD (1<<0)
typedef struct {char name[MAX_OSPATH];} model_t;
typedef struct {int number,renderfx,renderamt;} EntityStateAdapter;
typedef struct {int index;qboolean player;EntityStateAdapter curstate;model_t* model;} cl_entity_t;
typedef struct {char model[64];} player_info_t;
#define Q_strcmp strcmp
#define Q_strncpy strncpy
#define Q_snprintf snprintf
#define FBitSet(value,bits) ((value)&(bits))
@PLAYER_MODEL_TYPE@
static struct {player_model_t player_models[4];} g_studio;
static struct {int maxclients;} client;
static struct {int developer;} globals;
#define gp_cl (&client)
#define gpGlobals (&globals)
static struct {struct {int flags;} rvp;cl_entity_t* currententity;model_t* currentmodel;} RI;
static player_info_t info;
static cl_entity_t entities[4];
static model_t base,changed,world,custom,dead;
static int singleplayer=1,infoCalls=0,missingInfo=0,fileExists=1;
#define PARM_SINGLEPLAYER_GAME 0
#define ENGINE_GET_PARM(parm) singleplayer
static player_info_t* getInfo(int index) {++infoCalls;return index==0 && !missingInfo ? &info : NULL;}
static qboolean exists(const char* path,qboolean gamedir) {(void)path;(void)gamedir;return fileExists;}
static model_t* load(const char* name,qboolean crash,qboolean track) {(void)name;(void)crash;(void)track;return &custom;}
typedef struct {qboolean (*FileExists)(const char*,qboolean);} FileSystemAdapter;
static FileSystemAdapter filesystem={exists};
static struct {
    player_info_t* (*pfnPlayerInfo)(int);
    FileSystemAdapter* fsapi;
    model_t* (*Mod_ForName)(const char*,qboolean,qboolean);
} gEngfuncs={getInfo,&filesystem,load};
static cl_entity_t* CL_GetEntityByIndex(int index) {return index>0 && index<4 ? &entities[index] : NULL;}
@SELECTOR@
int main(int argc,char** argv) {
    assert(argc==2);client.maxclients=1;
    entities[1].player=true;entities[1].index=entities[1].curstate.number=1;entities[1].model=&base;
    RI.rvp.flags=RF_DRAW_WORLD;strcpy(info.model,"gordon");
    if(!strcmp(argv[1],"first-sp")) assert(R_StudioSetupPlayerModel(0)==&base);
    else if(!strcmp(argv[1],"first-dev")) {globals.developer=2;assert(R_StudioSetupPlayerModel(0)==&custom);}
    else if(!strcmp(argv[1],"stale-sp")) {entities[0].model=&world;RI.currententity=&entities[0];assert(R_StudioSetupPlayerModel(0)==&base);}
    else if(!strcmp(argv[1],"no-info")) {missingInfo=1;globals.developer=2;RI.currententity=&entities[1];assert(R_StudioSetupPlayerModel(0)==&base);}
    else if(!strcmp(argv[1],"bad-index")) {assert(!R_StudioSetupPlayerModel(-1));assert(!R_StudioSetupPlayerModel(1));assert(infoCalls==0);}
    else if(!strcmp(argv[1],"fallback-update")) {
        singleplayer=0;fileExists=0;RI.currententity=&entities[1];
        assert(R_StudioSetupPlayerModel(0)==&base);entities[1].model=&changed;
        assert(R_StudioSetupPlayerModel(0)==&changed);
    } else if(!strcmp(argv[1],"menu-preview")) {
        RI.currententity=&entities[0];entities[0].model=&world;RI.rvp.flags=0;
        assert(R_StudioSetupPlayerModel(0)==&custom);
    } else if(!strcmp(argv[1],"dead-body")) {
        entities[2].model=&dead;entities[2].curstate.renderfx=kRenderFxDeadPlayer;
        entities[2].curstate.renderamt=1;RI.currententity=&entities[2];info.model[0]=0;
        assert(R_StudioSetupPlayerModel(0)==&dead);
    } else assert(0);
    printf("%s production selector checks passed\n",argv[1]);return 0;
}
