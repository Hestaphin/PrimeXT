HWND GetFocus(){return focus;}
std::wstring Number(double value,int precision=2){std::wostringstream o;o<<std::fixed<<std::setprecision(precision)<<value;return o.str();}
ULONGLONG now=0;ULONGLONG GetTickCount64(){return now;}
int soundPlays=0;bool PlaySoundW(LPCWSTR data,void*,unsigned flags){if(data){++soundPlays; (void)flags;}return true;}
void Cell(HWND w,int row,int col,const std::wstring& text){if(int(w->cells.size())<=row)w->cells.resize(row+1);if(int(w->cells[row].size())<=col)w->cells[row].resize(col+1);w->cells[row][col]=text;}
