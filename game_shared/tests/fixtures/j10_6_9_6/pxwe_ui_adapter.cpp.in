int GlobalUnlock(HGLOBAL){return TRUE;}HGLOBAL GlobalFree(HGLOBAL p){std::free(p);return nullptr;}
HGLOBAL SetClipboardData(unsigned,HGLOBAL p){std::free(p);return reinterpret_cast<HGLOBAL>(1);}
