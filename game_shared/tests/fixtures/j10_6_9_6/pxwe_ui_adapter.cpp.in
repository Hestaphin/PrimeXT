@ENUM@
#include "fixtures/pxwe_legacy_seed.h"
class Application{
public:
    pxwe::Project project;
    pxwe::fs::path executable; pxwe::PreviewCamera camera; double animationRate=1.0;
    HWND cameraPreset=nullptr,cameraFit=nullptr,cameraReset=nullptr,cameraFov=nullptr,cameraScale=nullptr,animationSpeed=nullptr;
    HWND window=nullptr,tree=nullptr,tabs=nullptr,properties=nullptr,value=nullptr,apply=nullptr,browse=nullptr,hint=nullptr;
    HWND compatibility=nullptr,allow=nullptr,disallow=nullptr,setDefault=nullptr,flight=nullptr;
    HWND modelKind=nullptr,modelLoad=nullptr,modelOpen=nullptr,modelInfo=nullptr,sequences=nullptr,bounds=nullptr,status=nullptr;
    HWND variants=nullptr,variantAdd=nullptr,variantEdit=nullptr,variantCopy=nullptr,variantRemove=nullptr,variantPreview=nullptr;
    HWND play=nullptr,reset=nullptr,sound=nullptr,skin=nullptr,body=nullptr,coefficient=nullptr,overrides=nullptr;
    HWND curvesList=nullptr,metric=nullptr,spriteKind=nullptr,spriteLoad=nullptr,spriteWindow=nullptr,spriteInfo=nullptr;
    std::vector<std::string> variantIds,modelPaths,spritePaths,compatibilityIds;
    pxwe::StudioPreview studio;pxwe::SpritePreview sprite;pxwe::Bytes soundData;
    pxwe::fs::path modelPath;std::wstring modelText;bool hasSprite=false;double spriteSeconds=0;ULONGLONG lastTick=0;
    pxwe::ModelInfo model;std::vector<pxwe::AmmoCurve> curves;std::set<std::string> hiddenCurves;
    std::vector<modular::BallisticState> trajectory;std::wstring flightText;
    bool hasModel=false,playing=false;int sequenceIndex=0;double animationSeconds=0;
    void OpenFolder(){}void OpenModelViewer(){}
    bool updating=false;pxwe::Kind selectionKind=pxwe::Kind::Weapon;std::string selectionId="pistol",editingKey,editingValue;
    std::vector<std::string> propertyKeys;std::vector<pxwe::PropertyRow> propertyRows;std::set<std::string> collapsedSections;
    std::vector<pxwe::Category> treeCategories; bool categorySelected=false,treeRefreshPending=false; std::string selectionCategory;
    std::string CurrentCategory() const {const auto* a=project.Find(selectionKind,selectionId); return categorySelected?selectionCategory:a?a->Get("category"):"";}
    void CategoryCommand(int){}
    std::vector<std::pair<pxwe::Kind,std::string>> treeAssets;int titles=0,refreshes=0,compatibilityCalls=0,flightCalls=0;
    int Scale(int n)const{return n;}
    void Title(){++titles;}
    void RefreshTree(){++refreshes;RefreshSelection();}
@PRODUCTION@
    void Setup(const pxwe::fs::path& root){
        modals.clear();seenRoles.clear();seenConditions.clear();now=0;soundPlays=0;
        windows.clear();focus=nullptr;inputAnswers.clear();errors=0;dialogFile.clear();dialogError=0;
        window=ControlWindow(L"FRAME",L"",0,0);
        HWND* controls[]={&cameraPreset,&cameraFit,&cameraReset,&cameraFov,&cameraScale,&animationSpeed,&tree,&tabs,&properties,&value,&apply,&browse,&hint,&compatibility,&allow,&disallow,&setDefault,&flight,&modelKind,&modelLoad,&modelOpen,&modelInfo,&sequences,&bounds,&status,&variants,&variantAdd,&variantEdit,&variantCopy,&variantRemove,&variantPreview,&play,&reset,&sound,&skin,&body,&coefficient,&overrides,&curvesList,&metric,&spriteKind,&spriteLoad,&spriteWindow,&spriteInfo};
        for(auto c:controls)*c=ControlWindow(L"CONTROL",L"",0,0);
        tabs->select=0;SeedLegacyEditorProject(root);project.Load(root);
        RefreshSelection();
    }
    int Row(const std::string& key){
        const auto* a=project.Find(selectionKind,selectionId);const auto page=pxwe::PageForProperty(*a,key);const int tab=page==pxwe::PropertyPage::Models?3:page==pxwe::PropertyPage::Sprites?4:0;
        if(tabs->select!=tab){tabs->select=tab;RefreshProperties();}
        for(size_t i=0;i<propertyRows.size();++i)if(propertyRows[i].key==key)return int(i);
        throw std::runtime_error("missing row: "+key);}
    int Heading(const std::string& section){
        const auto* a=project.Find(selectionKind,selectionId);for(const auto& r:pxwe::PropertyRows(*a,{}))if(!r.Heading()&&r.section==section){const auto page=pxwe::PageForProperty(*a,r.key);const int tab=page==pxwe::PropertyPage::Models?3:page==pxwe::PropertyPage::Sprites?4:0;if(tabs->select!=tab){tabs->select=tab;RefreshProperties();}break;}
        for(size_t i=0;i<propertyRows.size();++i)if(propertyRows[i].Heading()&&propertyRows[i].section==section)return int(i);
        throw std::runtime_error("missing heading");}
};
void Check(bool v,const char* why){if(!v)throw std::runtime_error(why);}
void Reject(const std::function<void()>& f){bool threw=false;try{f();}catch(const std::exception&){threw=true;}Check(threw,"expected rejection");}
struct Temp{pxwe::fs::path path=pxwe::fs::temp_directory_path()/("pxwe-ui-"+std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));Temp(){pxwe::fs::create_directory(path);}~Temp(){std::error_code ec;pxwe::fs::remove_all(path,ec);}};
void Put(const pxwe::fs::path& path){pxwe::fs::create_directories(path.parent_path());std::ofstream out(path);out<<"resource";}
int passed=0,failed=0;
void Test(const char* name,const std::function<void(Application&,const pxwe::fs::path&)>& f){try{Temp t;Application a;a.Setup(t.path);f(a,t.path);++passed;std::cout<<"PASS "<<name<<'\n';}catch(const std::exception& e){++failed;std::cerr<<"FAIL "<<name<<": "<<e.what()<<'\n';}}
namespace f=preview_fixture;
bool HasRow(const Application& a,const std::string& key){return std::any_of(a.propertyRows.begin(),a.propertyRows.end(),[&](const auto& r){return r.key==key;});}
void Tab(Application& a,int page){NMHDR changing;changing.idFrom=C_TAB;changing.code=TCN_SELCHANGING;a.Notify(&changing);a.tabs->select=page;NMHDR changed;changed.idFrom=C_TAB;changed.code=TCN_SELCHANGE;a.Notify(&changed);}
int main(){
    std::cout<<std::unitbuf;std::cerr<<std::unitbuf;
    Test("page switches relocate controls and preserve pending general draft",[](auto& a,const auto&){Check(!HasRow(a,"view_model")&&!HasRow(a,"fire_sound")&&!HasRow(a,"sprite"),"resources remained on general page");a.EditProperty(a.Row("clip_size"));a.value->text=L"20";Tab(a,3);Check(a.project.Find(pxwe::Kind::Weapon,"pistol")->Get("clip_size")=="20","tab lost pending edit");Check(HasRow(a,"view_model")&&HasRow(a,"primary_sound")&&HasRow(a,"secondary_animation")&&!HasRow(a,"clip_size"),"model controls missing");Check(a.properties->visible&&a.variants->visible&&a.bounds->visible&&!a.spriteWindow->visible,"model page visibility");Tab(a,4);Check(HasRow(a,"sprite")&&!HasRow(a,"view_model")&&a.spriteWindow->visible&&!a.bounds->visible,"sprite page routing");});
    Test("model and sprite layout keeps preview away from editing controls",[](auto& a,const auto&){for(int tab:{3,4}){Tab(a,tab);Check(a.properties->rect.right<a.bounds->rect.left&&a.properties->rect.bottom<=a.hint->rect.top&&a.apply->rect.bottom<=a.variants->rect.top,"overlapping model/sprite controls");Check(a.variants->rect.bottom<=a.variantAdd->rect.top&&a.variantAdd->rect.bottom<=a.variantPreview->rect.top,"overlapping conditional controls");}Tab(a,1);Check(a.compatibility->rect.bottom<a.allow->rect.top&&a.allow->rect.bottom<a.coefficient->rect.top,"ammo buttons overlap");});
    Test("add conditional entry upgrades once and exposes it on model page",[](auto& a,const auto&){Tab(a,3);modals={{1,"normal","view_model","models/normal.mdl","default",{}}};a.Command(C_VARIANT_ADD);Check(a.variantIds==std::vector<std::string>{"normal"}&&HasRow(a,"asset.normal.path")&&a.project.Validate().Ok(),"conditional add missing");Check(a.project.Undo()&&a.project.Find(pxwe::Kind::Weapon,"pistol")->Get("version")=="2","conditional add split history");});
    Test("duplicate default offers random condition and preserves source",[](auto& a,const auto&){a.project.PutVariant("pistol","normal","view_model","models/normal.mdl","default");Tab(a,3);a.variants->select=0;modals={{2,"copy","","","",{}}};a.Command(C_VARIANT_COPY);const auto* w=a.project.Find(pxwe::Kind::Weapon,"pistol");Check(w->Get("asset.normal.when")=="default"&&w->Get("asset.copy.when")=="random"&&w->Get("asset.copy.path")=="models/normal.mdl","duplicate damaged default");});
    Test("conditional dialog retries bad condition and supports edit rename",[](auto& a,const auto&){Tab(a,3);modals={{1,"one","fire_sound","weapons/f.wav","ammo:unknown",{}},{1,"one","fire_sound","weapons/f.wav","ammo:fmj",{}}};a.Command(C_VARIANT_ADD);Check(errors==1&&a.variantIds.size()==1,"invalid condition not retried");Check(std::find(seenConditions.begin(),seenConditions.end(),"ammo:fmj")!=seenConditions.end()&&std::find(seenConditions.begin(),seenConditions.end(),"ammo:unknown")==seenConditions.end(),"conditions contain unallowed ammo");a.variants->select=0;modals={{1,"renamed","reload_sound","weapons/r.wav","mode:semi",{}}};a.Command(C_VARIANT_EDIT);const auto* w=a.project.Find(pxwe::Kind::Weapon,"pistol");Check(w->Get("asset.one.role").empty()&&w->Get("asset.renamed.path")=="weapons/r.wav","edit rename incomplete");});
    Test("cancel conditional dialog leaves project and undo stack intact",[](auto& a,const auto&){Tab(a,3);a.Command(C_VARIANT_ADD);Check(!a.project.Dirty()&&a.variantIds.empty(),"cancel committed data");Check(!a.project.Undo(),"cancel added history");});
    Test("sprite dialog roles filter and model variants remain intact",[](auto& a,const auto&){a.project.PutVariant("pistol","model","view_model","models/a.mdl","random");Tab(a,4);modals={{1,"icon","hud_sprite","sprites/a.txt","ammo:fmj",{}}};a.Command(C_VARIANT_ADD);Check(seenRoles==std::vector<std::string>{"sprite","hud_sprite","kill_sprite"}&&a.variantIds==std::vector<std::string>{"icon"},"sprite dialog routing");Tab(a,3);Check(a.variantIds==std::vector<std::string>{"model"},"model variant lost");});
    Test("remove conditional entry is undoable",[](auto& a,const auto&){a.project.PutVariant("pistol","one","reload_sound","weapons/r.wav","random");Tab(a,3);a.variants->select=0;a.Command(C_VARIANT_REMOVE);Check(a.variantIds.empty()&&a.project.Undo()&&a.project.Find(pxwe::Kind::Weapon,"pistol")->Get("asset.one.role")=="reload_sound","remove history failed");});
    Test("ammo table damage is computed for every allowed speed",[](auto& a,const auto&){a.project.Add(pxwe::Kind::Cartridge,"jhp","fmj");a.project.Allow("pistol","jhp","200");a.RefreshCompatibility();Check(a.compatibility->cells.size()==2&&a.compatibility->cells[0][4]!=L"—"&&a.compatibility->cells[1][4]!=L"—","allowed damage missing");a.project.Disallow("pistol","jhp");a.RefreshCompatibility();Check(a.compatibility->cells[1][4]==L"—","disallowed damage displayed");});
    Test("coefficient handler converts cartridge atomically and refreshes curves",[](auto& a,const auto&){a.compatibility->select=0;inputAnswers={L"3"};a.Command(C_COEFFICIENT);const auto* c=a.project.Find(pxwe::Kind::Cartridge,"fmj");Check(c->Get("version")=="3"&&c->Get("damage").empty()&&c->Get("damage_coefficient")=="3","coefficient controller failed");Check(std::abs(std::stod(Utf8(a.compatibility->cells[0][4]))-a.curves[0].muzzleDamage)<.0001,"stale computed damage");a.project.Undo();Check(a.project.Find(pxwe::Kind::Cartridge,"fmj")->Get("version")=="2","conversion not atomic");});
    Test("invalid or cancelled coefficient handler preserves cartridge",[](auto& a,const auto&){const auto before=a.project.Find(pxwe::Kind::Cartridge,"fmj")->Serialize();a.compatibility->select=0;a.Command(C_COEFFICIENT);Check(a.project.Find(pxwe::Kind::Cartridge,"fmj")->Serialize()==before,"cancel coefficient changed data");inputAnswers={L"0"};Reject([&]{a.Command(C_COEFFICIENT);});Check(a.project.Find(pxwe::Kind::Cartridge,"fmj")->Serialize()==before,"bad coefficient left mixed fields");});
    Test("ammo override dialog applies and clears firing reload and sprite paths",[](auto& a,const auto&){a.compatibility->select=0;modals={{1,"","","","",{{"fire_sound","weapons/f.wav"},{"reload_sound","weapons/r.wav"},{"sprite","sprites/a.spr"}}}};a.Command(C_OVERRIDES);const auto* w=a.project.Find(pxwe::Kind::Weapon,"pistol");Check(w->Get("ammo.fmj.fire_sound")=="weapons/f.wav"&&a.compatibility->cells[0][5]==L"weapons/f.wav"&&a.spritePaths==std::vector<std::string>{"sprites/a.spr"},"override routing failed");a.compatibility->select=0;modals={{1,"","","","",{{"fire_sound",""},{"reload_sound",""}}}};a.Command(C_OVERRIDES);w=a.project.Find(pxwe::Kind::Weapon,"pistol");Check(w->Get("ammo.fmj.fire_sound").empty()&&w->Get("ammo.fmj.reload_sound").empty()&&w->Get("ammo.fmj.sprite")=="sprites/a.spr","clear override removed other data");});
    Test("cancel ammo override dialog does not upgrade weapon",[](auto& a,const auto&){a.compatibility->select=0;a.Command(C_OVERRIDES);Check(!a.project.Dirty()&&a.project.Find(pxwe::Kind::Weapon,"pistol")->Get("version")=="2","cancel upgraded weapon");});
    Test("model load handler renders texture and selected sequence plays",[](auto& a,const auto& root){f::Put(root/"models/v_pistol.mdl",f::Model());Tab(a,3);a.Command(C_MODEL_LOAD);Check(a.hasModel&&a.model.sequences.size()==2&&a.playing&&a.sequences->cells.size()==2,"model not loaded");const auto idle=a.studio.Render(100,100,0,0,0,0).pixels;NMLISTVIEW change;change.hdr.idFrom=C_SEQUENCES;change.hdr.code=LVN_ITEMCHANGED;change.uChanged=LVIF_STATE;change.uNewState=LVIS_SELECTED;change.iItem=1;a.Notify(&change.hdr);Check(a.sequenceIndex==1&&a.animationSeconds==0&&a.playing,"sequence selection ignored");now=50;a.Tick();Check(a.animationSeconds>0&&a.bounds->invalidates,"playback timer inactive");Check(idle!=a.studio.Render(100,100,a.sequenceIndex,.5,0,0).pixels,"model did not animate");});
    Test("pause restart and hidden page suspend model playback",[](auto& a,const auto& root){f::Put(root/"models/v_pistol.mdl",f::Model());Tab(a,3);a.Command(C_MODEL_LOAD);now=100;a.Tick();const auto before=a.animationSeconds;a.Command(C_PLAY);now=200;a.Tick();Check(a.animationSeconds==before&&!a.playing,"pause failed");a.Command(C_RESET);Check(a.animationSeconds==0,"restart failed");a.Command(C_PLAY);Tab(a,0);now=300;a.Tick();Check(a.animationSeconds==0,"hidden model keeps playing");});
    Test("conditional and ammo model resources can load in native preview",[](auto& a,const auto& root){f::Put(root/"models/variant.mdl",f::Model());a.project.PutVariant("pistol","one","view_model","models/variant.mdl","random");a.project.SetAmmoOverrides("pistol","fmj",{{"world_model","models/variant.mdl"}});a.RefreshResources();Tab(a,3);a.variants->select=0;a.Command(C_VARIANT_PREVIEW);Check(a.hasModel&&a.modelPath==root/"models/variant.mdl"&&a.modelPaths.size()==5,"variant model load failed");});
    Test("sprites preview frames and native timer advances animation",[](auto& a,const auto& root){f::Put(root/"sprites/test.spr",f::Sprite());a.project.SetSprite(pxwe::Kind::Weapon,"pistol","sprites/test.spr");a.RefreshResources();Tab(a,4);a.Command(C_SPRITE_LOAD);Check(a.hasSprite&&a.sprite.Frames().size()==2&&a.spriteInfo->text.find(L"2 frames")!=std::wstring::npos,"sprite controller failed");now=80;a.Tick();Check(a.spriteSeconds>0&&a.spriteWindow->invalidates,"sprite timer inactive");});
    Test("sound control retains resource buffer for asynchronous playback",[](auto& a,const auto& root){f::Put(root/"sound/weapons/f.wav",std::string("RIFF fixture"));a.project.SetField(pxwe::Kind::Weapon,"pistol","fire_sound","weapons/f.wav");a.EditProperty(a.Row("fire_sound"));a.Command(C_SOUND);Check(soundPlays==1&&std::string(a.soundData.begin(),a.soundData.end())=="RIFF fixture","sound memory lifetime missing");});
    Test("curve checkboxes hide one cartridge and retain selection after refresh",[](auto& a,const auto&){a.project.Add(pxwe::Kind::Cartridge,"jhp","fmj");a.project.Allow("pistol","jhp","250");a.RefreshFlight();Check(a.curves.size()==2&&a.curvesList->checks[0]&&a.curvesList->checks[1],"all curves not visible");a.curvesList->checks[1]=false;NMLISTVIEW change;change.hdr.idFrom=C_CURVES;change.hdr.code=LVN_ITEMCHANGED;change.uChanged=LVIF_STATE;change.iItem=1;a.Notify(&change.hdr);Check(a.hiddenCurves.count("jhp")&&a.flight->invalidates,"checkbox didn't hide");a.RefreshFlight();Check(a.curvesList->checks[0]&&!a.curvesList->checks[1],"refresh forgot visibility");});
    Test("each comparison curve has a stable distinct color and metric changes redraw",[](auto& a,const auto&){std::set<COLORREF> colors;for(size_t i=0;i<24;++i)Check(colors.insert(a.CurveColor(i)).second,"duplicate curve color");for(int selected:{0,1,2}){a.metric->select=selected;const int before=a.flight->invalidates;a.Command(C_METRIC);Check(a.flight->invalidates>before,"metric change didn't redraw");}NMLVCUSTOMDRAW draw;draw.nmcd.hdr.idFrom=C_CURVES;draw.nmcd.hdr.code=NM_CUSTOMDRAW;draw.nmcd.dwDrawStage=CDDS_ITEMPREPAINT|CDDS_SUBITEM;draw.nmcd.dwItemSpec=1;draw.iSubItem=1;a.Notify(&draw.nmcd.hdr);Check(draw.clrText==a.CurveColor(1),"legend color mismatch");});
    Test("committing a draft preserves selected entry and model role",[](auto& a,const auto&){a.project.PutVariant("pistol","one","view_model","models/one.mdl","random");Tab(a,3);a.modelKind->select=2;a.EditProperty(a.Row("fire_sound"));a.value->text=L"weapons/f.wav";a.variants->select=0;modals={{2,"copy","","","",{}}};a.Command(C_VARIANT_COPY);Check(a.project.Find(pxwe::Kind::Weapon,"pistol")->Get("asset.copy.path")=="models/one.mdl"&&a.modelKind->select==2,"draft commit lost resource selection");});
    Test("applying unchanged blank overrides preserves legacy weapon",[](auto& a,const auto&){a.compatibility->select=0;modals={{1,"","","","",{}}};a.Command(C_OVERRIDES);Check(!a.project.Dirty()&&a.project.Find(pxwe::Kind::Weapon,"pistol")->Get("version")=="2","blank overrides upgraded weapon");});
    Test("shared model paths keep the selected role after refresh",[](auto& a,const auto&){for(const auto* role:{"view_model","player_model","world_model"})a.project.SetField(pxwe::Kind::Weapon,"pistol",role,"models/shared.mdl");a.RefreshResources();a.modelKind->select=2;a.RefreshResources();Check(a.modelKind->select==2,"shared paths reset world role to view");});
    std::cout<<passed<<" passed, "<<failed<<" failed\n";return failed?1:0;
}
