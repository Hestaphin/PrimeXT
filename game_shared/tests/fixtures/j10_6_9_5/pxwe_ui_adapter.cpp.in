// Real Application methods, with Windows controls/dialogs adapted explicitly.
// Does not certify Windows painting, SDK linking or native message ordering.
#include "pxwe_properties.h"
#include "pxwe_preview.h"
#include "pxwe_resource.h"
#include <algorithm>
#include <chrono>
#include <cstdint>
#include <cwchar>
#include <fstream>
#include <functional>
#include <iostream>
#include <memory>
#include <stdexcept>

using DWORD=unsigned long; using WPARAM=uintptr_t; using LPARAM=intptr_t; using LRESULT=intptr_t;
using INT_PTR=intptr_t; using HMENU=void*;
constexpr int FALSE=0,TRUE=1,SW_SHOW=1,SW_HIDE=0,LVIS_SELECTED=2,LVIS_FOCUSED=1,LVNI_SELECTED=2,LVIF_STATE=8;
constexpr DWORD WS_CHILD=1,WS_VISIBLE=2,WS_CLIPSIBLINGS=4,RDW_INVALIDATE=1,RDW_ERASE=2,RDW_ALLCHILDREN=4;
constexpr int CB_RESETCONTENT=1,CB_ADDSTRING=2,CB_SETEDITSEL=3,WM_SETREDRAW=4,CB_GETCURSEL=5,VK_RETURN=13;
constexpr unsigned TVN_SELCHANGINGW=1,TVN_SELCHANGEDW=2,LVN_ITEMCHANGING=3,LVN_ITEMCHANGED=4,NM_DBLCLK=5,TCN_SELCHANGING=6,TCN_SELCHANGE=7,LVN_KEYDOWN=8,NM_CUSTOMDRAW=9;
constexpr int MB_OK=0,MB_ICONERROR=1;
constexpr DWORD OFN_FILEMUSTEXIST=1,OFN_PATHMUSTEXIST=2,OFN_NOCHANGEDIR=4,OFN_EXPLORER=8;
#define MAKELPARAM(a,b) (LPARAM((unsigned short)(a)) | (LPARAM((unsigned short)(b)) << 16))
struct RECT { int left=0,top=0,right=1180,bottom=780; };
struct Fake { DWORD style=0; bool enabled=true,visible=true,redraw=true; int invalidates=0,select=-1,selectAll=0; RECT rect; std::wstring text; std::vector<std::wstring> choices; std::vector<std::vector<std::wstring>> cells; };
using HWND=Fake*;
std::vector<std::unique_ptr<Fake>> windows;
HWND focus=nullptr; void* gInstance=nullptr;
HWND CreateWindowExW(int,const wchar_t*,const wchar_t* text,DWORD style,int,int,int,int,HWND,HMENU,void*,void*) {
    windows.push_back(std::make_unique<Fake>()); auto w=windows.back().get(); w->style=style; w->text=text; return w;
}
LRESULT SendMessageW(HWND w,int msg,WPARAM,LPARAM data) {
    if(msg==CB_RESETCONTENT)w->choices.clear();
    if(msg==CB_ADDSTRING)w->choices.push_back(reinterpret_cast<const wchar_t*>(data));
    if(msg==CB_SETEDITSEL)++w->selectAll;
    if(msg==CB_GETCURSEL)return w->select;
    return 0;
}
void EnableWindow(HWND w,int enabled){w->enabled=enabled!=0;}
void SetWindowTextW(HWND w,const wchar_t* text){w->text=text;}
void SetFocus(HWND w){focus=w;}
std::wstring Text(HWND w){return w->text;}
std::wstring Wide(const std::string& text){return {text.begin(),text.end()};}
std::string Utf8(const std::wstring& text){return {text.begin(),text.end()};}
void ShowWindow(HWND w,int show){w->visible=show==SW_SHOW;}
void RedrawWindow(HWND w,void*,void*,DWORD){++w->invalidates;}
void MoveWindow(HWND w,int x,int y,int width,int height,int){w->rect={x,y,x+width,y+height};}
void GetClientRect(HWND w,RECT* rect){*rect={0,0,w->rect.right-w->rect.left,w->rect.bottom-w->rect.top};}
int TabCtrl_GetCurSel(HWND w){return w->select;}
void TabCtrl_AdjustRect(HWND,int,RECT* rect){rect->left+=4;rect->top+=28;rect->right-=4;rect->bottom-=4;}
void ListView_DeleteAllItems(HWND w){w->cells.clear();w->select=-1;}
void ListView_SetColumnWidth(HWND,int,int){}
int ListView_GetNextItem(HWND w,int,int){return w->select;}
void ListView_SetItemState(HWND w,int row,int,int){w->select=row;}
void ListView_EnsureVisible(HWND,int,int){}
void InvalidateRect(HWND w,void*,int){++w->invalidates;}
int ListView_GetCheckState(HWND,int){return 1;}
void Cell(HWND w,int row,int col,const std::wstring& text){if(int(w->cells.size())<=row)w->cells.resize(row+1);if(int(w->cells[row].size())<=col)w->cells[row].resize(col+1);w->cells[row][col]=text;}
struct NMHDR{HWND hwndFrom=nullptr;uintptr_t idFrom=0;unsigned code=0;};
struct NMLISTVIEW{NMHDR hdr;int iItem=-1;unsigned uChanged=0,uNewState=0,uOldState=0;};
struct NMITEMACTIVATE{NMHDR hdr;int iItem=-1,iSubItem=0;};
struct NMTVKEYDOWN{NMHDR hdr;unsigned short wVKey=0;};
struct NMLVKEYDOWN{NMHDR hdr;unsigned short wVKey=0;};
struct TreeItem{LPARAM lParam=-1;};struct NMTREEVIEWW{NMHDR hdr;TreeItem itemNew;};
struct Input{std::wstring title,prompt,value;};
std::vector<std::wstring> inputAnswers;int errors=0;
bool Ask(HWND,Input& input){if(inputAnswers.empty())return false;input.value=inputAnswers.front();inputAnswers.erase(inputAnswers.begin());return true;}
int MessageBoxW(HWND,const wchar_t*,const wchar_t*,int){++errors;return 0;}
struct OPENFILENAMEW{DWORD lStructSize=0;HWND hwndOwner=nullptr;const wchar_t* lpstrFilter=nullptr;wchar_t* lpstrFile=nullptr;DWORD nMaxFile=0;const wchar_t* lpstrInitialDir=nullptr;const wchar_t* lpstrTitle=nullptr;DWORD Flags=0;};
pxwe::fs::path dialogFile;DWORD dialogError=0,dialogFlags=0;std::wstring dialogDirectory,dialogFilter;
bool GetOpenFileNameW(OPENFILENAMEW* o){dialogFlags=o->Flags;dialogDirectory=o->lpstrInitialDir;dialogFilter=o->lpstrFilter;if(dialogFile.empty())return false;const auto path=dialogFile.wstring();if(path.size()>=o->nMaxFile)throw std::runtime_error("adapter file buffer");std::copy(path.begin(),path.end(),o->lpstrFile);o->lpstrFile[path.size()]=0;return true;}
DWORD CommDlgExtendedError(){return dialogError;}
constexpr int WM_COMMAND=99;
int PostMessageW(HWND,int,WPARAM,LPARAM){return TRUE;}
constexpr unsigned TVN_KEYDOWN=77; constexpr int VK_F2=113;
@ENUM@
class Application{
public:
    pxwe::Project project;
    HWND window=nullptr,tree=nullptr,tabs=nullptr,properties=nullptr,value=nullptr,apply=nullptr,browse=nullptr,hint=nullptr;
    HWND compatibility=nullptr,allow=nullptr,disallow=nullptr,setDefault=nullptr,flight=nullptr;
    HWND modelKind=nullptr,modelLoad=nullptr,modelOpen=nullptr,modelInfo=nullptr,sequences=nullptr,bounds=nullptr,status=nullptr;
    HWND variants=nullptr,variantAdd=nullptr,variantEdit=nullptr,variantCopy=nullptr,variantRemove=nullptr,variantPreview=nullptr;
    HWND play=nullptr,reset=nullptr,sound=nullptr,skin=nullptr,body=nullptr,coefficient=nullptr,overrides=nullptr;
    HWND curvesList=nullptr,metric=nullptr,spriteKind=nullptr,spriteLoad=nullptr,spriteWindow=nullptr,spriteInfo=nullptr;
    pxwe::ModelInfo model;std::vector<pxwe::AmmoCurve> curves;std::set<std::string> hiddenCurves;
    bool hasModel=false,playing=false;int sequenceIndex=0;double animationSeconds=0;
    void RefreshResources(){}void RefreshVariants(){}void VariantCommand(int){}LRESULT CurveCustomDraw(NMHDR*){return 0;}
    bool updating=false;pxwe::Kind selectionKind=pxwe::Kind::Weapon;std::string selectionId="pistol",editingKey,editingValue;
    std::vector<std::string> propertyKeys;std::vector<pxwe::PropertyRow> propertyRows;std::set<std::string> collapsedSections;
    std::vector<pxwe::Category> treeCategories; bool categorySelected=false,treeRefreshPending=false; std::string selectionCategory;
    std::string CurrentCategory() const {const auto* a=project.Find(selectionKind,selectionId); return categorySelected?selectionCategory:a?a->Get("category"):"";}
    void CategoryCommand(int){}
    std::vector<std::pair<pxwe::Kind,std::string>> treeAssets;int titles=0,refreshes=0,compatibilityCalls=0,flightCalls=0;
    int Scale(int n)const{return n;}
    void Title(){++titles;}
    void RefreshTree(){++refreshes;RefreshProperties();}
    void RefreshSelection(){RefreshProperties();}
    void RefreshCompatibility(){++compatibilityCalls;}
    void RefreshFlight(){++flightCalls;}
    void CompatibilityCommand(int){++compatibilityCalls;}
@PRODUCTION@
    void Setup(const pxwe::fs::path& root){
        windows.clear();focus=nullptr;inputAnswers.clear();errors=0;dialogFile.clear();dialogError=0;
        window=ControlWindow(L"FRAME",L"",0,0);
        HWND* controls[]={&tree,&tabs,&properties,&value,&apply,&browse,&hint,&compatibility,&allow,&disallow,&setDefault,&flight,&modelKind,&modelLoad,&modelOpen,&modelInfo,&sequences,&bounds,&status,&variants,&variantAdd,&variantEdit,&variantCopy,&variantRemove,&variantPreview,&play,&reset,&sound,&skin,&body,&coefficient,&overrides,&curvesList,&metric,&spriteKind,&spriteLoad,&spriteWindow,&spriteInfo};
        for(auto c:controls)*c=ControlWindow(L"CONTROL",L"",0,0);
        tabs->select=0;project.Load(root);project.Add(pxwe::Kind::Cartridge,"fmj");project.Add(pxwe::Kind::Weapon,"pistol");project.Save();
        RefreshProperties();
    }
    int Row(const std::string& key){
        const auto* a=project.Find(selectionKind,selectionId);const auto page=pxwe::PageForProperty(*a,key);const int tab=page==pxwe::PropertyPage::Models?3:page==pxwe::PropertyPage::Sprites?4:0;
        if(tabs->select!=tab){tabs->select=tab;RefreshProperties();}
        for(size_t i=0;i<propertyRows.size();++i)if(propertyRows[i].key==key)return int(i);
        throw std::runtime_error("missing row: "+key);}
    int Heading(const std::string& section){
        const auto* a=project.Find(selectionKind,selectionId);for(const auto& r:pxwe::PropertyRows(*a,{}))if(!r.Heading()&&r.section==section){const auto page=pxwe::PageForProperty(*a,r.key);const int tab=page==pxwe::PropertyPage::Models?3:page==pxwe::PropertyPage::Sprites?4:0;if(tabs->select!=tab){tabs->select=tab;RefreshProperties();}break;}
        for(size_t i=0;i<propertyRows.size();++i)if(propertyRows[i].Heading()&&propertyRows[i].section==section)return int(i);
        throw std::runtime_error("missing heading");}
};
void Check(bool v,const char* why){if(!v)throw std::runtime_error(why);}
void Reject(const std::function<void()>& f){bool threw=false;try{f();}catch(const std::exception&){threw=true;}Check(threw,"expected rejection");}
struct Temp{pxwe::fs::path path=pxwe::fs::temp_directory_path()/("pxwe-ui-"+std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));Temp(){pxwe::fs::create_directory(path);}~Temp(){std::error_code ec;pxwe::fs::remove_all(path,ec);}};
void Put(const pxwe::fs::path& path){pxwe::fs::create_directories(path.parent_path());std::ofstream out(path);out<<"resource";}
int passed=0,failed=0;
void Test(const char* name,const std::function<void(Application&,const pxwe::fs::path&)>& f){try{Temp t;Application a;a.Setup(t.path);f(a,t.path);++passed;std::cout<<"PASS "<<name<<'\n';}catch(const std::exception& e){++failed;std::cerr<<"FAIL "<<name<<": "<<e.what()<<'\n';}}
int main(){
    Test("control creation clips overlapping siblings",[](auto& a,const auto&){Check((a.tabs->style&WS_CLIPSIBLINGS)&&(a.properties->style&WS_CLIPSIBLINGS)&&(a.hint->style&WS_CLIPSIBLINGS),"unclipped control");});
    Test("layout separates list help and edit controls",[](auto& a,const auto&){a.Layout();Check(a.properties->rect.bottom<=a.hint->rect.top&&a.hint->rect.bottom<=a.value->rect.top,"overlapping property controls");Check(a.value->rect.right<a.browse->rect.left&&a.browse->rect.right<a.apply->rect.left,"overlapping edit buttons");});
    Test("page changes include browse and invalidate children",[](auto& a,const auto&){a.tabs->select=1;a.ShowPage();Check(!a.properties->visible&&!a.browse->visible&&a.compatibility->visible&&a.window->invalidates,"page visibility");a.tabs->select=0;a.ShowPage();Check(a.browse->visible&&a.properties->visible&&!a.compatibility->visible,"return page");});
    Test("property selection supplies help choices and browse state",[](auto& a,const auto&){a.EditProperty(a.Row("version"));Check(a.hint->text.find(L"Format 3")!=std::wstring::npos&&std::find(a.value->choices.begin(),a.value->choices.end(),L"3")!=a.value->choices.end()&&!a.browse->enabled,"version help");a.EditProperty(a.Row("view_model"));Check(a.browse->enabled,"model not browsable");});
    Test("ID selection and activation cannot edit",[](auto& a,const auto&){a.ActivateProperty(a.Row("id"));Check(!a.value->enabled&&!a.apply->enabled&&!a.browse->enabled&&focus!=a.value,"ID editable");});
    Test("double click value focuses and selects edit text",[](auto& a,const auto&){NMITEMACTIVATE click;click.hdr.idFrom=C_PROPERTIES;click.hdr.code=NM_DBLCLK;click.iItem=a.Row("clip_size");click.iSubItem=1;a.Notify(&click.hdr);Check(focus==a.value&&a.value->selectAll&&a.editingKey=="clip_size","double click did not edit");});
    Test("double click section collapses without dirtying project",[](auto& a,const auto&){const auto count=a.propertyRows.size();NMITEMACTIVATE click;click.hdr.idFrom=C_PROPERTIES;click.hdr.code=NM_DBLCLK;click.iItem=a.Heading("Primary attack");a.Notify(&click.hdr);Check(a.propertyRows.size()<count&&!a.project.Dirty(),"collapse mutated data");click.iItem=a.Heading("Primary attack");a.Notify(&click.hdr);Check(a.propertyRows.size()==count,"expand failed");});
    Test("collapse commits pending changes and leaves section selected",[](auto& a,const auto&){a.EditProperty(a.Row("clip_size"));a.value->text=L"20";a.ActivateProperty(a.Heading("Inventory and HUD"));Check(a.project.Find(pxwe::Kind::Weapon,"pistol")->Get("clip_size")=="20","pending edit lost");Check(a.properties->select==a.Heading("Inventory and HUD"),"heading not selected");});
    Test("section selection disables value editing",[](auto& a,const auto&){a.EditProperty(a.Row("view_model"));a.EditProperty(a.Heading("Identity"));Check(a.editingKey.empty()&&!a.value->enabled&&!a.browse->enabled,"heading can edit");});
    Test("property selection change commits old draft first",[](auto& a,const auto&){a.EditProperty(a.Row("clip_size"));a.value->text=L"18";NMLISTVIEW change;change.hdr.idFrom=C_PROPERTIES;change.hdr.code=LVN_ITEMCHANGING;change.uChanged=LVIF_STATE;change.uOldState=LVIS_SELECTED;a.Notify(&change.hdr);Check(a.project.Find(pxwe::Kind::Weapon,"pistol")->Get("clip_size")=="18","old value lost");change.hdr.code=LVN_ITEMCHANGED;change.uNewState=LVIS_SELECTED;change.uOldState=0;change.iItem=a.Row("max_carry");a.Notify(&change.hdr);Check(a.editingKey=="max_carry","new selection missing");});
    Test("failed pending commit preserves old editor state",[](auto& a,const auto&){a.EditProperty(a.Row("display_name"));a.value->text=L"bad\nname";Reject([&]{a.EditProperty(a.Row("clip_size"));});Check(a.editingKey=="display_name"&&!a.project.Dirty(),"failed commit moved editor");});
    Test("Enter notification activates a property",[](auto& a,const auto&){a.properties->select=a.Row("reload_seconds");NMLVKEYDOWN key;key.hdr.idFrom=C_PROPERTIES;key.hdr.code=LVN_KEYDOWN;key.wVKey=VK_RETURN;a.Notify(&key.hdr);Check(focus==a.value&&a.editingKey=="reload_seconds","Enter did not edit");});
    Test("resource dialog applies sound relative path through history",[](auto& a,const auto& root){Put(root/"sound/weapons/fire.wav");a.EditProperty(a.Row("fire_sound"));dialogFile=root/"sound/weapons/fire.wav";a.BrowseProperty();Check(a.project.Find(pxwe::Kind::Weapon,"pistol")->Get("fire_sound")=="weapons/fire.wav"&&a.value->text==L"weapons/fire.wav","wrong sound value");Check((dialogFlags&OFN_NOCHANGEDIR)&&(dialogFlags&OFN_FILEMUSTEXIST),"dialog flags");Check(a.project.Undo()&&a.project.Find(pxwe::Kind::Weapon,"pistol")->Get("fire_sound").empty(),"browse not in history");});
    Test("cancelled browse preserves draft and history",[](auto& a,const auto&){a.EditProperty(a.Row("view_model"));a.value->text=L"models/draft.mdl";a.BrowseProperty();Check(a.value->text==L"models/draft.mdl"&&!a.project.Dirty(),"Cancel changed state");});
    Test("outside browse selection leaves draft and project intact",[](auto& a,const auto&){Temp outside;Put(outside.path/"v.mdl");a.EditProperty(a.Row("view_model"));a.value->text=L"models/draft.mdl";dialogFile=outside.path/"v.mdl";Reject([&]{a.BrowseProperty();});Check(a.value->text==L"models/draft.mdl"&&!a.project.Dirty(),"failed browse changed data");});
    Test("invalid draft path cannot set browser start outside game",[](auto& a,const auto& root){a.EditProperty(a.Row("view_model"));a.value->text=L"../../outside.mdl";a.BrowseProperty();Check(dialogDirectory==(root/"models").wstring(),"escaped start directory");});
    Test("existing conditional path uses its current role filter",[](auto& a,const auto& root){a.project.SetField(pxwe::Kind::Weapon,"pistol","asset.a.role","reload_sound");a.project.SetField(pxwe::Kind::Weapon,"pistol","asset.a.path","weapons/old.wav");a.RefreshProperties();a.EditProperty(a.Row("asset.a.path"));Put(root/"sound/weapons/new.wav");dialogFile=root/"sound/weapons/new.wav";a.BrowseProperty();Check(a.project.Find(pxwe::Kind::Weapon,"pistol")->Get("asset.a.path")=="weapons/new.wav"&&dialogFilter.find(L"*.wav")!=std::wstring::npos,"conditional browse");});
    Test("duplicate ID dialog retries and creates only valid ID",[](auto& a,const auto&){inputAnswers={L"PISTOL",L"new_gun"};a.NewAsset(pxwe::Kind::Weapon,false);Check(errors==1&&a.project.Data().weapons.size()==2&&a.selectionId=="new_gun","duplicate dialog retry");Check(a.project.Find(pxwe::Kind::Weapon,"new_gun")->Get("view_model")=="models/v_new_gun.mdl","new model path");});
    Test("cancel after duplicate collision creates no asset",[](auto& a,const auto&){inputAnswers={L"PISTOL"};a.NewAsset(pxwe::Kind::Weapon,false);Check(errors==1&&a.project.Data().weapons.size()==1&&!a.project.Dirty(),"cancel mutated project");});
    Test("tree changing and tab changing commit the pending edit",[](auto& a,const auto&){a.EditProperty(a.Row("clip_size"));a.value->text=L"19";NMHDR h;h.idFrom=C_TREE;h.code=TVN_SELCHANGINGW;a.Notify(&h);Check(a.project.Find(pxwe::Kind::Weapon,"pistol")->Get("clip_size")=="19","tree commit");a.value->text=L"21";h.idFrom=C_TAB;h.code=TCN_SELCHANGING;a.Notify(&h);Check(a.project.Find(pxwe::Kind::Weapon,"pistol")->Get("clip_size")=="21","tab commit");});
    Test("blank property removal remains repairable",[](auto& a,const auto&){a.EditProperty(a.Row("pickup_sound"));a.value->text=L"weapons/pick.wav";a.CommitEditor();a.value->text=L"";a.CommitEditor();Check(a.project.Find(pxwe::Kind::Weapon,"pistol")->Get("pickup_sound").empty()&&a.project.Validate().Ok(),"blank removal");});
    Test("repeated refresh clears stale help and invalidates property list",[](auto& a,const auto&){a.EditProperty(a.Row("view_model"));a.RefreshProperties();Check(a.editingKey.empty()&&!a.browse->enabled&&a.properties->invalidates&&a.hint->text.find(L"Select a property")!=std::wstring::npos,"stale help after refresh");});
    std::cout<<passed<<" passed, "<<failed<<" failed\n";return failed?1:0;
}
